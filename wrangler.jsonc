{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-chat-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_PASSWORD": "520812cc",
    "WEBHOOK_URL": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=1b3976d0-f3fe-4a82-a05b-7cab8a254611"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "REGISTRY",
        "class_name": "RoomRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "RoomRegistry"]
    }
  ]
}
